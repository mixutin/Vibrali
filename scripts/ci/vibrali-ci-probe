#!/usr/bin/env bash
set -euo pipefail

SERIAL="$(cat /sys/class/dmi/id/product_serial 2>/dev/null || true)"
[[ "$SERIAL" == "VIBRALI-CI" ]] || exit 0

STATE_DIR=/var/lib/vibrali/ci
COUNT_FILE="$STATE_DIR/boot-count"
PERSIST_FILE="$STATE_DIR/persistence-marker"
PACKAGE_NAME=vibrali-ci-persistence-marker
FAILURES=0

mkdir -p "$STATE_DIR"

emit() {
  printf '%s\n' "$*"
  printf '%s\n' "$*" > /dev/ttyS0 2>/dev/null || true
}

pass() {
  emit "VIBRALI_CI_PASS $1"
}

fail() {
  emit "VIBRALI_CI_FAIL $1"
  FAILURES=$((FAILURES + 1))
}

check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    pass "$name"
  else
    fail "$name"
  fi
}

# Called indirectly through check(), which ShellCheck cannot infer.
# shellcheck disable=SC2317
check_command() {
  command -v "$1" >/dev/null 2>&1
}

# shellcheck disable=SC2317
check_socat_ncat_loopback() {
  local dir port server
  dir="$(mktemp -d)"
  port=39091
  timeout 8 socat -u "TCP4-LISTEN:${port},bind=127.0.0.1,reuseaddr" - > "$dir/out" 2>"$dir/socat.err" &
  server=$!
  sleep 0.5
  printf "vibrali-loopback\n" | ncat 127.0.0.1 "$port"
  wait "$server"
  grep -qx "vibrali-loopback" "$dir/out"
  rm -rf "$dir"
}

# shellcheck disable=SC2317
check_nonroot_dumpcap() {
  local capture pid
  capture=/tmp/vibrali-ci-nonroot.pcapng
  rm -f "$capture"
  id -nG vibrali | tr " " "\n" | grep -Fxq wireshark
  getcap /usr/bin/dumpcap | grep -Fq "cap_net_admin"
  getcap /usr/bin/dumpcap | grep -Fq "cap_net_raw"
  runuser -u vibrali -- timeout 8 dumpcap -q -i lo -c 1 -w "$capture" >/tmp/vibrali-ci-dumpcap.log 2>&1 &
  pid=$!
  sleep 0.7
  ncat -z 127.0.0.1 9 >/dev/null 2>&1 || true
  wait "$pid"
  test -s "$capture"
  rm -f "$capture" /tmp/vibrali-ci-dumpcap.log
}

# shellcheck disable=SC2317
check_32bit_build() {
  local dir
  dir="$(mktemp -d)"
  printf "int main(void) { return 0; }\n" | gcc -m32 -x c - -o "$dir/vibrali32"
  file "$dir/vibrali32" | grep -Fq "ELF 32-bit"
  "$dir/vibrali32"
  rm -rf "$dir"
}

previous=0
if [[ -r "$COUNT_FILE" ]]; then
  read -r previous < "$COUNT_FILE" || previous=0
fi
[[ "$previous" =~ ^[0-9]+$ ]] || previous=0
count=$((previous + 1))
printf '%s\n' "$count" > "$COUNT_FILE"

check "user-vibrali" id vibrali

password_state="$(passwd -S vibrali 2>/dev/null | awk '{print $2}' || true)"
if [[ "$password_state" == "P" ]]; then
  pass "user-password-set"
else
  fail "user-password-set"
fi

check "networkmanager-active" systemctl is-active --quiet NetworkManager
check "lightdm-active" systemctl is-active --quiet lightdm
check "xfce-installed" test -x /usr/bin/startxfce4
check "efi-fallback-loader" test -f /boot/efi/EFI/BOOT/BOOTX64.EFI
check "profile-registry" test -s /etc/vibrali/profiles
check "root-writable" test -w /
check "nftables-active" systemctl is-active --quiet nftables
check "nftables-baseline-loaded" nft list table inet vibrali
check "apparmor-active" systemctl is-active --quiet apparmor

check "tool-base-python" python3 --version
check "tool-base-pipx" pipx --version
check "tool-base-curl" curl --version
check "tool-base-wget" wget --version
check "tool-base-jq" jq --version
check "tool-desktop-firefox" check_command firefox-esr
check "tool-desktop-chromium" chromium --version

check "tool-network-nmap" nmap --version
check "tool-network-masscan" masscan --version
check "tool-network-tcpdump" tcpdump --version
check "tool-network-tshark" tshark --version
check "tool-network-socat" check_command socat
check "tool-network-ncat" check_command ncat
check "tool-network-dig" check_command dig
check "tool-network-whois" check_command whois
check "tool-network-openvpn" check_command openvpn
check "tool-network-wireguard" check_command wg
check "tool-network-proxychains" check_command proxychains4
check "network-socat-ncat-loopback" check_socat_ncat_loopback
check "network-nonroot-dumpcap" check_nonroot_dumpcap

check "tool-web-sqlmap" sqlmap --version
check "tool-web-nikto" check_command nikto
check "tool-web-ffuf" check_command ffuf
check "tool-web-gobuster" check_command gobuster
check "tool-web-wfuzz" check_command wfuzz

check "tool-auth-hashcat" hashcat --version
check "tool-auth-john" check_command john
check "tool-auth-hydra" check_command hydra
check "tool-directory-kinit" check_command kinit
check "tool-directory-ldapsearch" check_command ldapsearch

check "tool-pwn-gcc" gcc --version
check "tool-pwn-gef" gdb -q -nx -batch \
  -ex "source /usr/local/lib/vibrali/gef.py" \
  -ex "pi assert \"gef\" in globals()"
check "tool-pwn-clang" clang --version
check "tool-pwn-make" make --version
check "tool-pwn-pwntools" python3 -c 'import pwn'
check "tool-pwn-readelf" readelf --version
check "tool-pwn-objdump" objdump --version
check "tool-pwn-32bit-build" check_32bit_build

check "tool-reverse-gdb" gdb --version
check "tool-reverse-lldb" lldb --version
check "tool-reverse-strace" strace -V
check "tool-reverse-ltrace" check_command ltrace
check "tool-reverse-qemu-user" check_command qemu-x86_64
check "tool-reverse-apktool" check_command apktool
check "tool-reverse-java" java -version
check "tool-reverse-valgrind" valgrind --version
check "tool-reverse-patchelf" patchelf --version
check "tool-reverse-nasm" nasm -v

check "tool-crypto-openssl" openssl version

check "tool-forensics-binwalk" check_command binwalk
check "tool-forensics-sleuthkit" check_command tsk_recover
check "tool-forensics-autopsy" check_command autopsy
check "tool-forensics-yara" yara --version
check "tool-forensics-exiftool" exiftool -ver
check "tool-forensics-foremost" check_command foremost
check "tool-forensics-testdisk" check_command testdisk
check "tool-forensics-photorec" check_command photorec

check "tool-wireless-aircrack" check_command aircrack-ng
check "tool-wireless-hcxtools" check_command hcxpcapngtool
check "tool-wireless-reaver" check_command reaver
check "tool-wireless-bully" check_command bully

check "tool-directory-impacket" python3 -c 'import impacket'
check "tool-defensive-lynis" check_command lynis

if [[ $count -eq 1 ]]; then
  printf 'vibrali-qemu-persistence\n' > "$PERSIST_FILE"

  package_root="$(mktemp -d)"
  mkdir -p "$package_root/DEBIAN" "$package_root/usr/local/share"
  cat > "$package_root/DEBIAN/control" <<EOF
Package: $PACKAGE_NAME
Version: 1.0
Section: misc
Priority: optional
Architecture: all
Maintainer: Vibrali CI <noreply@invalid>
Description: Disposable package used only by the Vibrali QEMU persistence smoke test
EOF
  printf 'installed-by-vibrali-ci\n' > "$package_root/usr/local/share/vibrali-ci-package-marker"
  dpkg-deb --build "$package_root" /tmp/vibrali-ci-marker.deb >/dev/null
  if dpkg -i /tmp/vibrali-ci-marker.deb >/dev/null 2>&1; then
    pass "package-install"
  else
    fail "package-install"
  fi
  rm -rf "$package_root" /tmp/vibrali-ci-marker.deb
else
  if grep -qx 'vibrali-qemu-persistence' "$PERSIST_FILE" 2>/dev/null; then
    pass "writable-state-persisted"
  else
    fail "writable-state-persisted"
  fi

  if dpkg-query -W -f='${Status}\n' "$PACKAGE_NAME" 2>/dev/null |
      grep -qx 'install ok installed'; then
    pass "package-install-persisted"
  else
    fail "package-install-persisted"
  fi

  check "package-file-persisted" test -f /usr/local/share/vibrali-ci-package-marker
fi

sync

if [[ $FAILURES -eq 0 ]]; then
  emit "VIBRALI_CI_BOOT_OK count=$count failures=0"
else
  emit "VIBRALI_CI_BOOT_FAIL count=$count failures=$FAILURES"
fi

sync
systemctl --no-block poweroff
exit 0
