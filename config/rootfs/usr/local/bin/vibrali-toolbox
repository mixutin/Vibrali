#!/usr/bin/env bash
set -euo pipefail

category="${1:-}"
case "$category" in
  network) label="Network"; tools=(nmap masscan tcpdump tshark ncat socat arp-scan netdiscover bettercap proxychains4 openvpn) ;;
  web) label="Web"; tools=(burpsuite ffuf gobuster dirb dirsearch nikto sqlmap wfuzz whatweb recon-ng dnsrecon) ;;
  auth) label="Auth"; tools=(hashcat john hydra hashid crunch) ;;
  pwn) label="Pwn"; tools=(gcc g++ clang make python3) ;;
  reverse) label="Reverse"; tools=(cutter gdb gdb-multiarch lldb strace ltrace valgrind apktool patchelf) ;;
  crypto) label="Crypto"; tools=(openssl gp python3 z3) ;;
  forensics) label="Forensics"; tools=(binwalk foremost autopsy yara exiftool testdisk steghide) ;;
  wireless) label="Wireless"; tools=(aircrack-ng hcxdumptool hcxpcapngtool reaver bully iw rfkill macchanger) ;;
  directory) label="Directory"; tools=(impacket-smbclient ldapsearch kinit remmina) ;;
  defensive) label="Defensive"; tools=(lynis chkrootkit) ;;
  *)
    echo "Usage: vibrali-toolbox <network|web|auth|pwn|reverse|crypto|forensics|wireless|directory|defensive>" >&2
    exit 2
    ;;
esac

printf '\nVibrali %s toolbox\n' "$label"
printf '%*s\n' 48 '' | tr ' ' '-'
printf 'Installed commands detected on this USB:\n\n'
found=0
for tool in "${tools[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '  %-22s %s\n' "$tool" "$(command -v "$tool")"
    found=1
  fi
done
if [[ $found -eq 0 ]]; then
  printf '  No representative commands from this profile were found.\n'
  printf '  Check installed profiles with: vprofiles\n'
fi
printf '\nAuthorized testing only. Opening your normal shell...\n\n'
exec "${SHELL:-/bin/zsh}" -l
