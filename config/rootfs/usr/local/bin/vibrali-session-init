#!/usr/bin/env bash
set -u

wallpaper=/usr/share/backgrounds/vibrali/default.png

# Keep a predictable portable-workstation layout in the user's persistent home.
workdirs=(Projects Captures Labs Tools Wordlists)
for dir in "${workdirs[@]}"; do
  mkdir -p "$HOME/$dir"
done

# Surface the portable work folders in Thunar/GTK without replacing user bookmarks.
bookmark_file="$HOME/.config/gtk-3.0/bookmarks"
mkdir -p "$(dirname "$bookmark_file")"
touch "$bookmark_file"
for dir in "${workdirs[@]}"; do
  bookmark="file://$HOME/$dir $dir"
  grep -Fqx "$bookmark" "$bookmark_file" || printf '%s\n' "$bookmark" >> "$bookmark_file"
done

if command -v xfconf-query >/dev/null 2>&1; then
  xfconf-query -c xsettings -p /Net/ThemeName -s Arc-Dark 2>/dev/null || true
  xfconf-query -c xsettings -p /Net/IconThemeName -s Papirus-Dark 2>/dev/null || true
  xfconf-query -c xsettings -p /Gtk/FontName -s "Noto Sans 10" 2>/dev/null || true
  xfconf-query -c xfwm4 -p /general/theme -s Arc-Dark 2>/dev/null || true
  xfconf-query -c xfwm4 -p /general/title_font -s "JetBrains Mono Bold 10" 2>/dev/null || true
  xfconf-query -c xfce4-panel -p /panels/panel-1/size -s 38 2>/dev/null || true
  xfconf-query -c xfce4-panel -p /panels/panel-1/icon-size -s 20 2>/dev/null || true
  xfconf-query -c xfce4-panel -p /panels/panel-1/length -s 100 2>/dev/null || true
  xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -s true 2>/dev/null || true

  while IFS= read -r prop; do
    xfconf-query -c xfce4-desktop -p "$prop" -s "$wallpaper" 2>/dev/null || true
  done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$' || true)

  while IFS= read -r prop; do
    xfconf-query -c xfce4-desktop -p "$prop" -s 5 2>/dev/null || true
  done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/image-style$' || true)

  fallback=/backdrop/screen0/monitor0/workspace0/last-image
  fallback_style=/backdrop/screen0/monitor0/workspace0/image-style
  xfconf-query -c xfce4-desktop -p "$fallback" --create -t string -s "$wallpaper" 2>/dev/null || true
  xfconf-query -c xfce4-desktop -p "$fallback_style" --create -t int -s 5 2>/dev/null || true
fi

state_dir="$HOME/.config/vibrali"
mkdir -p "$state_dir"

rice_marker="$state_dir/desktop-rice-initialized"
if [[ ! -e "$rice_marker" ]] && command -v xfconf-query >/dev/null 2>&1; then
  xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>Return' --create -t string -s 'xfce4-terminal' >/dev/null 2>&1 || true
  xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>b' --create -t string -s 'brave-browser' >/dev/null 2>&1 || true
  xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>e' --create -t string -s 'thunar' >/dev/null 2>&1 || true
  xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>space' --create -t string -s 'xfce4-popup-whiskermenu' >/dev/null 2>&1 || true
  xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/Print' --create -t string -s 'xfce4-screenshooter' >/dev/null 2>&1 || true
  : > "$rice_marker"
fi

browser_marker="$state_dir/default-browser-initialized"
if [[ ! -e "$browser_marker" ]] && command -v brave-browser >/dev/null 2>&1; then
  if command -v xdg-settings >/dev/null 2>&1; then
    xdg-settings set default-web-browser brave-browser.desktop >/dev/null 2>&1 || true
  fi
  if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default brave-browser.desktop text/html >/dev/null 2>&1 || true
    xdg-mime default brave-browser.desktop x-scheme-handler/http >/dev/null 2>&1 || true
    xdg-mime default brave-browser.desktop x-scheme-handler/https >/dev/null 2>&1 || true
  fi
  : > "$browser_marker"
fi

display_marker="$state_dir/display-scale-initialized"
if [[ ! -e "$display_marker" ]] && command -v vibrali-display-scale >/dev/null 2>&1; then
  vibrali-display-scale auto >/dev/null 2>&1 || true
  : > "$display_marker"
fi

command -v xfdesktop >/dev/null 2>&1 && xfdesktop --reload >/dev/null 2>&1 || true
